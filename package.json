{
  "name": "faber-md-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "CC": "tsc -b && vite build --mode analyze",
    "size": "npm run build && size-limit",
    "prerender": "node scripts/prerender.mjs",
    "build:prerender": "npm run build && npm run prerender",
    "build:seo": "npm run build && npm run prerender",
    "sitemap:masters": "node scripts/generate-sitemap-masters.mjs",
    "generate-pwa-assets": "pwa-assets-generator",
    "prepare": "husky",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "npm run build && npx @lhci/cli autorun",
    "e2e": "playwright test",
    "e2e:api": "playwright test api-critical-flow",
    "e2e:ui": "playwright test ui-critical-flow",
    "e2e:headed": "playwright test --headed",
    "docker:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:build": "docker-compose -f docker-compose.dev.yml build",
    "docker:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "@fontsource/iosevka-charon-mono": "^5.2.1",
    "@fontsource/poppins": "^5.2.7",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.18.0",
    "formik": "^2.4.9",
    "framer-motion": "^12.38.0",
    "i18next": "^25.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.8",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "react-virtuoso": "^4.18.3",
    "recharts": "^3.8.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "web-vitals": "^5.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.54.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^4.1.4",
    "workbox-core": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
