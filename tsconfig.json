{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@faber/api-contract": ["../packages/api-contract/src/index.ts"],
      "@faber/api-contract/*": ["../packages/api-contract/src/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.ts",
    "pwa-assets.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "../analytics"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
