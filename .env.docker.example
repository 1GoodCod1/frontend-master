# Vite env vars for Docker development
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_ENV=development
VITE_USE_HTTPONLY=true

# CDN for static images (optional, Backblaze B2 / Cloudflare)
# e.g. https://f003.backblazeb2.com/file/moldmasters-uploads
# VITE_CDN_BASE_URL=

# OAuth (optional, sync with backend)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_ID_ENCRYPTION_SECRET=
